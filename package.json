{
  "name": "nova",
  "version": "2.1.0",
  "main": "main.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tfommy.nova",
    "productName": "Nova",
    "files": [
      "main.js",
      "server/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
